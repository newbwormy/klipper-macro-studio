{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Klipper Macro Studio",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/macro-engine",
          "sidecar": true
        }
      ]
    }
  ]
}
